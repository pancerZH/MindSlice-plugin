{
  "target": "antigravity",
  "driver": "antigravity",
  "host": "antigravity",
  "output": "plugins/antigravity",
  "manifest_path": "plugin.json",
  "page_limit": 15500,
  "hook_slots": 8,
  "hook_event": "SessionStart",
  "hook_command": "py adapter/hook.py || python3 adapter/hook.py || python adapter/hook.py",
  "hook_timeout": 60,
  "skills": {
    "setup": true,
    "review": true,
    "slice-maintainer": true,
    "slice-builder": false
  }
}
