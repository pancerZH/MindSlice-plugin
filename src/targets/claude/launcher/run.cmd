@echo off
rem MindSlice plugin launcher for Windows, generated by build/build.py from launcher/run.cmd.
rem Claude starts the MCP server as adapter/mcp, which resolves to this file through PATHEXT.
setlocal
where py >nul 2>nul || goto python
py "%CLAUDE_PLUGIN_ROOT%\adapter\entry.py" @ARGS@
rem Explicit code: a bare "exit /b" loses a failing exit code when the script runs as a process (cmd /c).
exit /b %ERRORLEVEL%
:python
python "%CLAUDE_PLUGIN_ROOT%\adapter\entry.py" @ARGS@
exit /b %ERRORLEVEL%
