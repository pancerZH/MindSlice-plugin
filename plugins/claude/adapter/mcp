#!/bin/sh
if command -v py >&2; then exec py "${CLAUDE_PLUGIN_ROOT}/adapter/entry.py" mcp; fi
if command -v python3 >&2; then exec python3 "${CLAUDE_PLUGIN_ROOT}/adapter/entry.py" mcp; fi
if command -v python >&2; then exec python "${CLAUDE_PLUGIN_ROOT}/adapter/entry.py" mcp; fi
echo "mindslice plugin: Python 3.12 or newer is required" >&2
exit 1
