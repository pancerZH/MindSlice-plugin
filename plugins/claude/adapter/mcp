#!/bin/sh
# MindSlice plugin launcher, generated by build/build.py from launcher/run.sh.
# Kept plain for the plugin directory validator: one literal path, fixed interpreter names, no other variables.
# The py launcher comes first because on Windows python3 is often the Microsoft Store placeholder.
if command -v py >/dev/null 2>&1; then exec py "${CLAUDE_PLUGIN_ROOT}/adapter/entry.py" mcp; fi
if command -v python3 >/dev/null 2>&1; then exec python3 "${CLAUDE_PLUGIN_ROOT}/adapter/entry.py" mcp; fi
if command -v python >/dev/null 2>&1; then exec python "${CLAUDE_PLUGIN_ROOT}/adapter/entry.py" mcp; fi
echo "mindslice plugin: no Python found; install Python 3.12 or newer" >&2
exit 1
