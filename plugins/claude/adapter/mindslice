#!/bin/sh
# MindSlice plugin launcher (adapter/mindslice): the hooks run it with sh, the MCP server is this file itself.
# Plain on purpose: the plugin directory's validator follows this script, so every path it runs is spelled as
# ${CLAUDE_PLUGIN_ROOT}/<file> and every interpreter by a fixed name (no computed paths, no variable commands).
# Claude sets CLAUDE_PLUGIN_ROOT for hooks and the MCP server; the Bash tool's mindslice command is a launcher
# that slot 1 writes to <plugin data>/bin and that runs entry.py directly. entry.py upgrades to Python 3.12+ itself.
if [ -z "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  echo "mindslice plugin: CLAUDE_PLUGIN_ROOT is not set (run the mindslice command instead)" >&2
  exit 1
fi
case "${OS:-}" in
  Windows_NT)
    # Git Bash: the py launcher first; python3 is often the Microsoft Store placeholder there.
    if command -v py >/dev/null 2>&1; then exec py "${CLAUDE_PLUGIN_ROOT}/adapter/entry.py" "$@"; fi
    if command -v python >/dev/null 2>&1; then exec python "${CLAUDE_PLUGIN_ROOT}/adapter/entry.py" "$@"; fi
    ;;
esac
if command -v python3 >/dev/null 2>&1; then exec python3 "${CLAUDE_PLUGIN_ROOT}/adapter/entry.py" "$@"; fi
if command -v python >/dev/null 2>&1; then exec python "${CLAUDE_PLUGIN_ROOT}/adapter/entry.py" "$@"; fi
echo "mindslice plugin: no Python found; install Python 3.12 or newer" >&2
exit 1
