{
  "description": "MindSlice: deliver the standing memory at session start, resume, clear and compaction (one page per command, all from one snapshot).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/adapter/hook-1\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/adapter/hook-2\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/adapter/hook-3\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/adapter/hook-4\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
