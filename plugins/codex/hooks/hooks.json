{
  "description": "MindSlice: deliver the standing memory at session start, resume, clear, fork and compaction.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/adapter/hook.py\" || py \"${PLUGIN_ROOT}/adapter/hook.py\" || python \"${PLUGIN_ROOT}/adapter/hook.py\"",
            "timeout": 60,
            "additionalContextLimit": 64000,
            "statusMessage": "Loading MindSlice memory"
          }
        ]
      }
    ]
  }
}
